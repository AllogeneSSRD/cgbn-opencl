        "v_sub_co_ci_u32 %[r5], vcc_lo, %[a5], %[b5], vcc_lo\n\t"
        "v_sub_co_ci_u32 %[r6], vcc_lo, %[a6], %[b6], vcc_lo\n\t"
        "v_sub_co_ci_u32 %[r7], vcc_lo, %[a7], %[b7], vcc_lo\n\t"
        "v_sub_co_ci_u32 %[r8], vcc_lo, %[a8], %[b8], vcc_lo\n\t"
        "v_sub_co_ci_u32 %[r9], vcc_lo, %[a9], %[b9], vcc_lo\n\t"
        "v_sub_co_ci_u32 %[r10], vcc_lo, %[a10], %[b10], vcc_lo\n\t"
        "v_sub_co_ci_u32 %[r11], vcc_lo, %[a11], %[b11], vcc_lo\n\t"
        "v_cndmask_b32   %[br], %[z], %[o], vcc_lo"

        : [r0] "=&v"(r0), [r1] "=&v"(r1), [r2] "=&v"(r2), [r3] "=&v"(r3), [r4] "=&v"(r4), [r5] "=&v"(r5), [r6] "=&v"(r6), [r7] "=&v"(r7), [r8] "=&v"(r8), [r9] "=&v"(r9), [r10] "=&v"(r10), [r11] "=&v"(r11),

          [br] "=&v"(br)

        : [a0] "v"(a0), [b0] "v"(b0), [a1] "v"(a1), [b1] "v"(b1), [a2] "v"(a2), [b2] "v"(b2), [a3] "v"(a3), [b3] "v"(b3), [a4] "v"(a4), [b4] "v"(b4), [a5] "v"(a5), [b5] "v"(b5), [a6] "v"(a6), [b6] "v"(b6), [a7] "v"(a7), [b7] "v"(b7), [a8] "v"(a8), [b8] "v"(b8), [a9] "v"(a9), [b9] "v"(b9), [a10] "v"(a10), [b10] "v"(b10), [a11] "v"(a11), [b11] "v"(b11),

          [br_bit] "v"(br_bit), [z] "v"(z), [o] "v"(o)

        : "vcc_lo");



    if (br != 0u) {

        c_fix_add_n12(&r0, &r1, &r2, &r3, &r4, &r5, &r6, &r7, &r8, &r9, &r10, &r11, n0, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11);

    }



    r[0] = r0;
    r[1] = r1;
    r[2] = r2;
    r[3] = r3;
    r[4] = r4;
    r[5] = r5;
    r[6] = r6;
    r[7] = r7;
    r[8] = r8;
    r[9] = r9;
    r[10] = r10;
    r[11] = r11;
    *br_out = br;

}

static inline void mp_add_mod_asm_128b(uint *r, const uint *a, const uint *b, const uint *N) {
    uint ca = 0u, cs = 1u;
    asm_fused_block4_priv(a, b, N, r, ca, cs, &ca, &cs);
}

static inline int mp_sub_mod_asm_128b(uint *r, const uint *a, const uint *b, const uint *N) {
    uint br = 0u;
    asm_sub_fused_block4_priv(a, b, N, r, br, &br);
    return br != 0u ? 1 : 0;
}

