    s = (ulong)a4 + (ulong)b4 + ca; ca = s >> 32;
    t = (ulong)(uint)s + (ulong)(~n4) + cs; cs = t >> 32; uint r4 = (uint)t;
    s = (ulong)a5 + (ulong)b5 + ca; ca = s >> 32;
