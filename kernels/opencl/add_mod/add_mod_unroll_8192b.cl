        ulong s = (ulong)r[250] + (ulong)N[250] + c;
        r[250] = (uint)s;
        c = s >> 32;
    }
    {
        ulong s = (ulong)r[251] + (ulong)N[251] + c;
        r[251] = (uint)s;
        c = s >> 32;
    }
    {
        ulong s = (ulong)r[252] + (ulong)N[252] + c;
        r[252] = (uint)s;
        c = s >> 32;
    }
    {
        ulong s = (ulong)r[253] + (ulong)N[253] + c;
        r[253] = (uint)s;
        c = s >> 32;
    }
    {
        ulong s = (ulong)r[254] + (ulong)N[254] + c;
        r[254] = (uint)s;
        c = s >> 32;
    }
    {
        ulong s = (ulong)r[255] + (ulong)N[255] + c;
        r[255] = (uint)s;
        c = s >> 32;
    }
}

static inline void add_mod_unroll_8192b(uint *r, const uint *a, const uint *b,
                                          const uint *N, uint limbs) {
    if (limbs == 256u) { add_mod_unroll_8192b_body(r, a, b, N); }
    (void)limbs;
}
