    for (uint i=0u;i<256u;++i) { ulong tv=(ulong)t[i],nv=(ulong)N[i]; ulong w=tv-nv-borrow; D[i]=(uint)w; borrow=(tv<nv+borrow)?1ul:0ul; }
    uint need_sub=(t[256u]|t[256u+1u])!=0u?1u:0u; need_sub=(borrow==0u)?1u:need_sub; uint mask=0u-need_sub;
    #pragma unroll
    for (uint i=0u;i<256u;++i) out[i]=(D[i]&mask)|(t[i]&~mask);
